# .gitignore - Git忽略文件配置

# 依赖项
node_modules/
pnpm-lock.yaml
yarn.lock
package-lock.json

# 构建输出
dist/
build/
*.tsbuildinfo

# 开发环境
.env
.env.local
.env.*.local

# IDE配置
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 运行时日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 临时文件
.tmp/
temp/
*.temp

# OS具体文件
Thumbs.db
.DS_Store
desktop.ini

# 编辑器
*.sublime-workspace
*.sublime-project


settings.local.json
.agents
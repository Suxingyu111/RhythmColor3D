{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "ES2015", "ES2016", "ES2017", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@game/*": ["game/*"],
      "@ui/*": ["ui/*"],
      "@audio/*": ["audio/*"],
      "@3d/*": ["3d/*"],
      "@managers/*": ["managers/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.old.ts", "src/game/RhythmDetector.ts", "src/game/ScoreManager.ts", "src/managers/LevelManager.ts"]
}
